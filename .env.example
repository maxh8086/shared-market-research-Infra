# up.ps1 creates .env with generated passwords the first time. Only these are safe to tune by hand.
# POSTGRES_ADMIN_PASSWORD, MONGO_ADMIN_PASSWORD and NEO4J_PASSWORD are generated; do not commit them.
POSTGRES_PORT=5432
MONGO_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
VLLM_PORT=8001
# Where the databases and model weights live on this machine (relative to this folder, or absolute).
DATA_DIR=./data
MODELS_DIR=./models
# Base image for vllm; set to reuse one you already have.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
